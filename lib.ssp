// Retries with exponential backoff and jitter, retry budgets, a circuit breaker, and token
// bucket and sliding window rate limiters. The runners sleep and read the time through the
// `clock` effect, so a test runs them on a virtual clock (`simulate`) and a program on the real
// one (`with_system_clock`); the breaker and limiters are pure state machines over explicit times.

// The clock the runners use. `retry_sleep(ms)` waits, `retry_now()` is the time in
// milliseconds. The `_now` runners handle it with the real clock and `simulate` with a virtual
// one; a handler of your own can do anything else (see the README).
pub effect clock
  retry_sleep(ms: Int)
  retry_now() -> Int

// How the delay before each retry is randomized (see the AWS Architecture Blog's
// "Exponential Backoff And Jitter"): none, uniform in [0, d] (full), d/2 plus uniform in
// [0, d/2] (equal), or uniform in [base, 3 * previous delay] (decorrelated).
pub type Jitter = NoJitter | FullJitter | EqualJitter | DecorrelatedJitter derive Eq, Show

// A retry policy. Attempt `n` (from 1) is followed, when it fails and may be retried, by a
// delay of `base_ms * multiplier ** (n - 1)` capped at `max_delay_ms`, then jittered.
// `budget_ms` bounds the total time from the first attempt: a retry whose delay would end past
// it is not made. `seed` seeds the jitter; `none` takes the clock's time at the start.
pub type Policy = {max_attempts: Int where _ >= 1, base_ms: Int where _ >= 0, multiplier: F64 where _ >= 1.0, max_delay_ms: Int where _ >= 0, jitter: Jitter, budget_ms: Opt[Int], seed: Opt[Int]} derive Eq, Show

// Why a run stopped.
pub type Stop = Succeeded | Exhausted | NotRetryable | BudgetExceeded derive Eq, Show

// The result of a run: the last result, the number of attempts made, each delay slept, their
// sum, and why it stopped.
pub type Outcome[T, E] = {result: Res[T, E], attempts: Int, delays: List[Int], waited_ms: Int, stop: Stop} derive Eq, Show

// ---------- policies ----------

// The default policy: 3 attempts, 100 ms doubling up to 10 s, full jitter, no budget.
pub fn default_policy() -> Policy
  post r.max_attempts == 3
= Policy{max_attempts: 3, base_ms: 100, multiplier: 2.0, max_delay_ms: 10000, jitter: FullJitter, budget_ms: none, seed: none}

// `attempts` attempts with the same `delay_ms` between them and no jitter.
pub fn constant(delay_ms: Int where _ >= 0, attempts: Int where _ >= 1) -> Policy
  post r.max_attempts == attempts and r.base_ms == delay_ms
= Policy{max_attempts: attempts, base_ms: delay_ms, multiplier: 1.0, max_delay_ms: delay_ms, jitter: NoJitter, budget_ms: none, seed: none}

// `attempts` attempts with delays doubling from `base_ms` up to 30 s, without jitter.
pub fn exponential(base_ms: Int where _ >= 0, attempts: Int where _ >= 1) -> Policy
  post r.max_attempts == attempts and r.base_ms == base_ms
= Policy{max_attempts: attempts, base_ms, multiplier: 2.0, max_delay_ms: 30000, jitter: NoJitter, budget_ms: none, seed: none}

// One attempt and no retries.
pub fn no_retry() -> Policy
  post r.max_attempts == 1
= constant(0, 1)

fn capped(p: Policy, x: F64) -> Int
= if x.is_nan or x >= p.max_delay_ms.to_f64 then p.max_delay_ms else if x <= 0.0 then 0 else x.round

fn rand_upto(seed: Int, hi: Int) -> (Int, Int)
= if hi <= 0 then (0, rand(seed).1) else rand_int(seed, 0, hi.saturating_add(1))

// The delay after failed attempt `attempt` before jitter: `base_ms * multiplier ** (attempt - 1)`
// capped at `max_delay_ms` (never overflowing).
pub fn base_delay(p: Policy, attempt: Int where _ >= 1) -> Int
  post r >= 0 and r <= max(p.max_delay_ms, 0)
= capped(p, p.base_ms.to_f64 * p.multiplier.pow((attempt - 1).to_f64))

// The jittered delay after failed attempt `attempt`, given the previous delay (`base_ms` before
// the first retry; only decorrelated jitter uses it) and a seed. Gives the delay and the next
// seed; the same inputs always give the same delay, which is never above `max_delay_ms`.
pub fn next_delay(p: Policy, attempt: Int where _ >= 1, prev_ms: Int, seed: Int) -> (Int, Int)
  post r.0 >= 0 and r.0 <= max(p.max_delay_ms, 0)
= do
  d = base_delay(p, attempt)
  match p.jitter
  | NoJitter => (d, seed)
  | FullJitter => rand_upto(seed, d)
  | EqualJitter => do
    half = d / 2
    (j, s) = rand_upto(seed, half)
    (d - half + j, s)
  | DecorrelatedJitter => do
    lo = min(p.base_ms, p.max_delay_ms)
    hi = max(prev_ms.saturating_mul(3), lo)
    (j, s) = if hi <= lo then (lo, rand(seed).1) else rand_int(seed, lo, hi.saturating_add(1))
    (min(j, p.max_delay_ms), s)

// The delays a run sleeps when every attempt fails: one per retry, `max_attempts - 1` in all,
// from `seed` (or 0 when the policy has none). Ignores the budget.
pub fn schedule(p: Policy) -> List[Int]
  post r.len == p.max_attempts - 1
= do
  var seed = p.seed.or(0)
  var prev = p.base_ms
  var out = []
  for n in 1..p.max_attempts
    (d, s) = next_delay(p, n, prev, seed)
    out := out.push(d)
    seed := s
    prev := d
  out

// The longest total time a run can sleep: the sum of the delays before jitter (decorrelated
// jitter can reach `max_delay_ms` on every retry, so it counts that).
pub fn worst_case_ms(p: Policy) -> Int
  post r >= 0
= (1..p.max_attempts).fold(0, (acc, n) => acc.saturating_add(if p.jitter == DecorrelatedJitter then max(p.max_delay_ms, 0) else base_delay(p, n)))

// ---------- running ----------

fn finish[T, E](result: Res[T, E], attempts: Int, delays: List[Int], stop: Stop) -> Outcome[T, E]
= Outcome{result, attempts, delays, waited_ms: delays.sum, stop}

// Runs `op(attempt)` (attempts count from 1) until it succeeds, `retryable` says an error is
// final, the attempts run out or the budget would be exceeded. `after(e)` may give a delay the
// error asks for, such as an HTTP Retry-After, which replaces the computed one (negative values
// count as 0); it is still bounded by the budget.
pub fn run_hinted[T, E, e](p: Policy, op: Int -> Res[T, E] ! e, retryable: E -> Bool, after: E -> Opt[Int]) -> Outcome[T, E] ! clock, e
= do
  start = retry_now()
  var seed = p.seed.or(start)
  var prev = p.base_ms
  var delays = []
  var attempt = 1
  var result = op(1)
  for _ in 1..p.max_attempts
    match result
    | ok(_) => return finish(result, attempt, delays, Succeeded)
    | err(e) => do
      if not retryable(e) then return finish(result, attempt, delays, NotRetryable)
      (d0, s) = next_delay(p, attempt, prev, seed)
      seed := s
      prev := d0
      d = max(after(e).or(d0), 0)
      if p.budget_ms is some(b) and retry_now() - start + d > b then return finish(result, attempt, delays, BudgetExceeded)
      retry_sleep(d)
      delays := delays.push(d)
      attempt := attempt + 1
      result := op(attempt)
  finish(result, attempt, delays, if result.is_ok then Succeeded else Exhausted)

// `run_hinted` without delay hints.
pub fn run_when[T, E, e](p: Policy, op: Int -> Res[T, E] ! e, retryable: E -> Bool) -> Outcome[T, E] ! clock, e
= run_hinted(p, op, retryable, x => none)

// `run_hinted` retrying every error, without delay hints.
pub fn run[T, E, e](p: Policy, op: Int -> Res[T, E] ! e) -> Outcome[T, E] ! clock, e
= run_hinted(p, op, x => true, x => none)

// `run_hinted` on the real clock: it sleeps with `sleep_ms` and reads `now_ms`.
pub fn run_hinted_now[T, E, e](p: Policy, op: Int -> Res[T, E] ! e, retryable: E -> Bool, after: E -> Opt[Int]) -> Outcome[T, E] ! time, e
= handle run_hinted(p, op, retryable, after)
| retry_sleep(ms) => do
  sleep_ms(max(ms, 0))
  resume()
| retry_now() => resume(now_ms())

// `run` on the real clock.
pub fn run_now[T, E, e](p: Policy, op: Int -> Res[T, E] ! e) -> Outcome[T, E] ! time, e
= run_hinted_now(p, op, x => true, x => none)

// `run_hinted` on a virtual clock that starts at `start_ms` and moves only when the runner
// sleeps, so nothing really waits. Gives the outcome and the virtual time at the end.
pub fn simulate_hinted[T, E, e](start_ms: Int, p: Policy, op: Int -> Res[T, E] ! e, retryable: E -> Bool, after: E -> Opt[Int]) -> (Outcome[T, E], Int) ! e
= do
  var t = start_ms
  o = handle run_hinted(p, op, retryable, after)
  | retry_sleep(ms) => do
    t := t + max(ms, 0)
    resume()
  | retry_now() => resume(t)
  (o, t)

// `run` on a virtual clock that starts at `start_ms` (see `simulate_hinted`).
pub fn simulate[T, E, e](start_ms: Int, p: Policy, op: Int -> Res[T, E] ! e) -> (Outcome[T, E], Int) ! e
= simulate_hinted(start_ms, p, op, x => true, x => none)

// ---------- circuit breaker ----------

// When a breaker trips and how it recovers. It opens when, among the calls of the last
// `window_ms`, there are `failure_threshold` failures, or at least `min_calls` calls of which
// a `failure_rate` share or more failed. It stays open for `cooldown_ms`, then lets
// `half_open_trials` calls through: all of them succeeding closes it, any failure opens it again.
pub type BreakerConfig = {failure_threshold: Int where _ >= 1, failure_rate: F64 where _ > 0.0 and _ <= 1.0, min_calls: Int where _ >= 1, window_ms: Int where _ >= 1, cooldown_ms: Int where _ >= 0, half_open_trials: Int where _ >= 1} derive Eq, Show

// A breaker's state: closed (calls go through), open until a time, or half open with the number
// of trial calls let through and the number that succeeded.
pub type BreakerState = Closed | Open{until_ms: Int} | HalfOpen{started: Int, succeeded: Int} derive Eq, Show

// A circuit breaker: its configuration, its state and the recent calls `(time_ms, succeeded)`.
pub type Breaker = {config: BreakerConfig, state: BreakerState, events: List[(Int, Bool)]} derive Eq, Show

// What `call` did: refused the call (the breaker is open; a call may go through in `wait_ms`),
// or ran it with this result.
pub type Called[T, E] = Rejected{wait_ms: Int} | Ran{result: Res[T, E]} derive Eq, Show

// The default breaker configuration: 5 failures, or half of at least 20 calls, within 60 s;
// open for 30 s; one trial call.
pub fn default_breaker_config() -> BreakerConfig
  post r.failure_threshold == 5
= BreakerConfig{failure_threshold: 5, failure_rate: 0.5, min_calls: 20, window_ms: 60000, cooldown_ms: 30000, half_open_trials: 1}

// A closed breaker with no history.
pub fn breaker(config: BreakerConfig) -> Breaker
  post r.state == Closed and r.events == []
= Breaker{config, state: Closed, events: []}

fn recent(b: Breaker, now: Int) -> List[(Int, Bool)]
= b.events.filter(ev => ev.0 > now - b.config.window_ms and ev.0 <= now)

// The calls and failures the breaker counts at `now`, those of the last `window_ms`.
pub fn window_counts(b: Breaker, now: Int) -> (Int, Int)
  post r.0 >= r.1 and r.1 >= 0
= do
  evs = recent(b, now)
  (evs.len, evs.filter(ev => not ev.1).len)

// The state at `now`: an open breaker whose cool-down has passed reads as half open.
pub fn current_state(b: Breaker, now: Int) -> BreakerState
= match b.state
| Open{until_ms} if now >= until_ms => HalfOpen{started: 0, succeeded: 0}
| s => s

// How long until a call may go through: 0 when it may now. While every half-open trial is in
// flight their results decide, and it gives `cooldown_ms`, the wait if one of them fails.
pub fn ms_until_allowed(b: Breaker, now: Int) -> Int
  post r >= 0
= match current_state(b, now)
| Closed => 0
| Open{until_ms} => until_ms - now
| HalfOpen{started} => if started < b.config.half_open_trials then 0 else b.config.cooldown_ms

// Asks to make a call at `now`: whether it may go through, and the breaker after counting it
// (an open breaker past its cool-down becomes half open and starts a trial).
pub fn allow(b: Breaker, now: Int) -> (Bool, Breaker)
= match current_state(b, now)
| Closed => (true, b)
| Open => (false, b)
| HalfOpen{started, succeeded} => if started < b.config.half_open_trials then (true, b with state := HalfOpen{started: started + 1, succeeded}) else (false, b with state := HalfOpen{started, succeeded})

fn trips(c: BreakerConfig, evs: List[(Int, Bool)]) -> Bool
= do
  fails = evs.filter(ev => not ev.1).len
  fails >= c.failure_threshold or evs.len >= c.min_calls and fails.to_f64 >= c.failure_rate * evs.len.to_f64

// Records a successful call at `now`. In the half-open state the last needed trial success
// closes the breaker and clears its history.
pub fn record_success(b: Breaker, now: Int) -> Breaker
= match current_state(b, now)
| Closed => b with events := recent(b, now).push((now, true))
| Open => b
| HalfOpen{started, succeeded} => if succeeded + 1 >= b.config.half_open_trials then b with state := Closed, events := [] else b with state := HalfOpen{started, succeeded: succeeded + 1}

// Records a failed call at `now`: a closed breaker opens when the failures reach the limits, a
// half-open one opens again at once.
pub fn record_failure(b: Breaker, now: Int) -> Breaker
= match current_state(b, now)
| Closed => do
  evs = recent(b, now).push((now, false))
  if trips(b.config, evs) then b with state := Open{until_ms: now + b.config.cooldown_ms}, events := [] else b with events := evs
| Open => b
| HalfOpen => b with state := Open{until_ms: now + b.config.cooldown_ms}, events := []

// Runs `op` through the breaker at `now`, counting the errors for which `counts(e)` holds as
// failures and every other result as a success (so a "not found" need not trip it).
pub fn call_when[T, E, e](b: Breaker, now: Int, op: () -> Res[T, E] ! e, counts: E -> Bool) -> (Called[T, E], Breaker) ! e
= do
  (ok_to_call, b1) = allow(b, now)
  if not ok_to_call then return (Rejected{wait_ms: ms_until_allowed(b1, now)}, b1)
  r = op()
  b2 = match r
  | err(e) if counts(e) => record_failure(b1, now)
  | _ => record_success(b1, now)
  (Ran{result: r}, b2)

// `call_when` counting every error as a failure.
pub fn call[T, E, e](b: Breaker, now: Int, op: () -> Res[T, E] ! e) -> (Called[T, E], Breaker) ! e
= call_when(b, now, op, x => true)

// ---------- rate limiting ----------

// A token bucket: up to `capacity` tokens, refilled continuously at `per_sec` tokens a second;
// `tokens` were left at `updated_ms`.
pub type Bucket = {capacity: Int where _ >= 1, per_sec: F64 where _ > 0.0, tokens: F64, updated_ms: Int} derive Eq, Show

// A sliding window limiter: at most `limit` calls in any `window_ms`; `hits` are the times of the
// calls still in the window.
pub type Window = {limit: Int where _ >= 1, window_ms: Int where _ >= 1, hits: List[Int]} derive Eq, Show

// A full bucket of `capacity` tokens at `now`.
pub fn bucket(capacity: Int where _ >= 1, per_sec: F64 where _ > 0.0, now: Int) -> Bucket
  post r.tokens == capacity.to_f64
= Bucket{capacity, per_sec, tokens: capacity.to_f64, updated_ms: now}

// The tokens available at `now` (a time before `updated_ms` refills nothing).
pub fn bucket_tokens(b: Bucket, now: Int) -> F64
  post r <= b.capacity.to_f64
= do
  elapsed = max(now - b.updated_ms, 0)
  min(b.capacity.to_f64, b.tokens + elapsed.to_f64 * b.per_sec / 1000.0)

fn refill(b: Bucket, now: Int) -> Bucket
= b with tokens := bucket_tokens(b, now), updated_ms := max(now, b.updated_ms)

// Takes `n` tokens at `now` if they are there: whether it did, and the bucket after.
pub fn bucket_take(b: Bucket, now: Int, n: Int where _ >= 0) -> (Bool, Bucket)
  post r.1.tokens >= 0.0 or not r.0
= do
  f = refill(b, now)
  if f.tokens >= n.to_f64 then (true, f with tokens := f.tokens - n.to_f64) else (false, f)

// How long until `n` tokens are there: 0 when they are now, `none` when `n` is more than the
// capacity (they never will be).
pub fn bucket_wait_ms(b: Bucket, now: Int, n: Int where _ >= 0) -> Opt[Int]
  post r.is_none or r.get >= 0
= do
  have = bucket_tokens(b, now)
  t = (n.to_f64 - have) * 1000.0 / b.per_sec
  if n > b.capacity then none else if have >= n.to_f64 then some(0) else some(if t < 9.2e18 then t.ceil else 9223372036854775807)

// An empty sliding window limiter.
pub fn window_limiter(limit: Int where _ >= 1, window_ms: Int where _ >= 1) -> Window
  post r.hits == []
= Window{limit, window_ms, hits: []}

fn live(w: Window, now: Int) -> List[Int]
= w.hits.filter(t => t > now - w.window_ms)

// How many more calls the window allows at `now`.
pub fn window_remaining(w: Window, now: Int) -> Int
  post r >= 0 and r <= w.limit
= max(w.limit - live(w, now).len, 0)

// Counts a call at `now` if the window allows it: whether it did, and the limiter after.
pub fn window_take(w: Window, now: Int) -> (Bool, Window)
= do
  hs = live(w, now)
  if hs.len < w.limit then (true, w with hits := hs.push(now)) else (false, w with hits := hs)

// How long until the window allows a call: 0 when it does now.
pub fn window_wait_ms(w: Window, now: Int) -> Int
  post r >= 0
= do
  hs = live(w, now)
  if hs.len < w.limit then 0 else max(hs.sort[hs.len - w.limit] + w.window_ms - now, 0)

// ---------- tests ----------

fn fails_until(n: Int, attempt: Int) -> Res[Int, Str]
= if attempt >= n then ok(attempt) else err("fail {attempt}")

fn always_fails(attempt: Int) -> Res[Int, Str]
= err("fail {attempt}")

fn slow_op(attempt: Int) -> Res[Int, Str] ! clock
= do
  retry_sleep(300)
  err("slow {attempt}")

fn cfg() -> BreakerConfig
= BreakerConfig{failure_threshold: 3, failure_rate: 1.0, min_calls: 100, window_ms: 1000, cooldown_ms: 500, half_open_trials: 2}

fn fail_at(b: Breaker, times: List[Int]) -> Breaker
= times.fold(b, (acc, t) => record_failure(acc, t))

test policies = default_policy() == Policy{max_attempts: 3, base_ms: 100, multiplier: 2.0, max_delay_ms: 10000, jitter: FullJitter, budget_ms: none, seed: none} and constant(250, 4).max_attempts == 4 and constant(250, 4).multiplier == 1.0 and exponential(10, 5).jitter == NoJitter and no_retry().max_attempts == 1 and schedule(no_retry()) == []

test base_delays = (1..7).map(n => base_delay(exponential(100, 8), n)) == [100, 200, 400, 800, 1600, 3200] and base_delay(exponential(100, 8), 2000) == 30000 and base_delay(constant(70, 3), 9) == 70 and base_delay(exponential(0, 3), 5) == 0 and base_delay(exponential(9223372036854775807, 3) with max_delay_ms := 9223372036854775807, 3) == 9223372036854775807

test no_jitter_schedule = schedule(exponential(100, 5)) == [100, 200, 400, 800] and schedule(constant(5, 3)) == [5, 5] and worst_case_ms(exponential(100, 5)) == 1500 and worst_case_ms(no_retry()) == 0 and worst_case_ms(exponential(9223372036854775807, 5) with max_delay_ms := 9223372036854775807) == 9223372036854775807

test full_jitter_bounds = do
  p = exponential(100, 10) with jitter := FullJitter
  (0..300).all(s => do
    (d, _) = next_delay(p, 4, 100, s)
    d >= 0 and d <= 800) and (0..300).map(s => next_delay(p, 4, 100, s).0).unique.len > 50

test equal_jitter_bounds = do
  p = exponential(100, 10) with jitter := EqualJitter
  (0..300).all(s => do
    (d, _) = next_delay(p, 4, 100, s)
    d >= 400 and d <= 800) and next_delay(p with base_ms := 0, 3, 0, 1).0 == 0

test decorrelated_bounds = do
  p = exponential(100, 10) with jitter := DecorrelatedJitter, max_delay_ms := 1000
  (0..300).all(s => do
    (d, _) = next_delay(p, 4, 300, s)
    d >= 100 and d <= 900) and (0..100).all(s => next_delay(p, 9, 5000, s).0 <= 1000) and next_delay(p, 1, 0, 3).0 >= 100

test seeded_determinism = do
  p = default_policy() with max_attempts := 8, seed := some(42)
  schedule(p) == schedule(p) and schedule(p).len == 7 and schedule(p).all(d => d >= 0 and d <= 10000) and schedule(p) != schedule(p with seed := some(43)) and next_delay(p, 3, 100, 9) == next_delay(p, 3, 100, 9)

test run_succeeds_after_failures = simulate(1000, constant(100, 5), a => fails_until(3, a)) == (Outcome{result: ok(3), attempts: 3, delays: [100, 100], waited_ms: 200, stop: Succeeded}, 1200)

test run_first_try = simulate(0, default_policy(), a => ok(a)) == (Outcome{result: ok(1), attempts: 1, delays: [], waited_ms: 0, stop: Succeeded}, 0)

test run_exhausts = simulate(0, exponential(50, 4), always_fails) == (Outcome{result: err("fail 4"), attempts: 4, delays: [50, 100, 200], waited_ms: 350, stop: Exhausted}, 350) and simulate(0, no_retry(), always_fails).0.stop == Exhausted

test run_stops_on_final_error = simulate_hinted(0, constant(10, 5), always_fails, e => e != "fail 2", x => none).0 == Outcome{result: err("fail 2"), attempts: 2, delays: [10], waited_ms: 10, stop: NotRetryable} and simulate(0, constant(10, 2), always_fails).0.stop == Exhausted

test run_budget = simulate(0, exponential(100, 10) with budget_ms := some(650), always_fails) == (Outcome{result: err("fail 3"), attempts: 3, delays: [100, 200], waited_ms: 300, stop: BudgetExceeded}, 300) and simulate(0, constant(100, 3) with budget_ms := some(0), always_fails).0.attempts == 1

test budget_counts_operation_time = do
  var t = 0
  o = handle run(constant(100, 10) with budget_ms := some(1000), slow_op)
  | retry_sleep(ms) => do
    t := t + ms
    resume()
  | retry_now() => resume(t)
  o == Outcome{result: err("slow 3"), attempts: 3, delays: [100, 100], waited_ms: 200, stop: BudgetExceeded} and t == 1100

test run_when_retryable = do
  var slept = []
  o = handle run_when(constant(7, 3), always_fails, x => true)
  | retry_sleep(ms) => do
    slept := slept.push(ms)
    resume()
  | retry_now() => resume(0)
  o.attempts == 3 and slept == [7, 7]

test hinted_delays = simulate_hinted(0, constant(10, 3), always_fails, x => true, e => if e == "fail 1" then some(5000) else some(-7)).0.delays == [5000, 0] and simulate_hinted(0, constant(10, 3) with budget_ms := some(1000), always_fails, x => true, x => some(5000)).0.stop == BudgetExceeded

test attempts_numbered = do
  (o, _) = simulate(0, constant(1, 4), always_fails)
  o.result == err("fail 4") and o.attempts == 4

test clock_seeded_jitter = do
  p = default_policy() with max_attempts := 5
  a = simulate(777, p, always_fails).0.delays
  b = simulate(777, p, always_fails).0.delays
  a == b and a.len == 4 and a.all(d => d >= 0 and d <= 10000)

test real_clock = run_hinted_now(constant(1, 3), a => fails_until(3, a), x => true, x => some(0)).delays == [0, 0] and run_now(constant(1, 2), a => fails_until(2, a)) == Outcome{result: ok(2), attempts: 2, delays: [1], waited_ms: 1, stop: Succeeded}

test breaker_trips_and_recovers = do
  b0 = breaker(cfg())
  b3 = fail_at(b0, [10, 20, 30])
  (a1, _) = allow(b3, 100)
  (h1, b4) = allow(b3, 600)
  (h2, b5) = allow(b4, 601)
  (h3, b6) = allow(b5, 602)
  b7 = record_success(record_success(b6, 610), 620)
  b0.state == Closed and fail_at(b0, [10, 20]).state == Closed and b3.state == Open{until_ms: 530} and not a1 and ms_until_allowed(b3, 100) == 430 and current_state(b3, 600) == HalfOpen{started: 0, succeeded: 0} and h1 and h2 and not h3 and b6.state == HalfOpen{started: 2, succeeded: 0} and ms_until_allowed(b6, 603) == 500 and record_success(b6, 610).state == HalfOpen{started: 2, succeeded: 1} and b7 == breaker(cfg())

test breaker_half_open_failure = do
  (_, b) = allow(fail_at(breaker(cfg()), [0, 1, 2]), 1000)
  record_failure(b, 1001).state == Open{until_ms: 1501} and ms_until_allowed(record_failure(b, 1001), 1001) == 500

test breaker_window_slides = fail_at(breaker(cfg()), [0, 500, 1200]).state == Closed and window_counts(fail_at(breaker(cfg()), [0, 500, 1200]), 1200) == (2, 1 + 1) and window_counts(breaker(cfg()), 5) == (0, 0) and fail_at(breaker(cfg()), [0, 500, 900]).state == Open{until_ms: 1400}

test breaker_failure_rate = do
  c = cfg() with failure_threshold := 100, failure_rate := 0.5, min_calls := 4
  b = record_success(record_failure(record_success(breaker(c), 1), 2), 3)
  b.state == Closed and record_failure(b, 4).state == Open{until_ms: 504} and window_counts(b, 3) == (3, 1) and record_success(b, 4).state == Closed

test breaker_ignores_late_results = do
  b = fail_at(breaker(cfg()), [0, 1, 2])
  record_success(b, 10) == b and record_failure(b, 10) == b and ms_until_allowed(breaker(cfg()), 0) == 0

test breaker_calls = do
  b = fail_at(breaker(cfg()), [0, 1])
  (r1, b1) = call(b, 5, () => fails_until(9, 1))
  (r2, b2) = call(b1, 6, () => ok(1))
  (r3, _) = call_when(breaker(cfg()), 0, () => err("404"), e => e != "404")
  r1 == Ran{result: err("fail 1")} and b1.state == Open{until_ms: 505} and r2 == Rejected{wait_ms: 499} and b2 == b1 and r3 == Ran{result: err("404")} and default_breaker_config().cooldown_ms == 30000

test bucket_takes = do
  b = bucket(10, 5.0, 0)
  (all_ok, b10) = (0..10).fold((true, b), (acc, i) => do
    (got, nb) = bucket_take(acc.1, 0, 1)
    (acc.0 and got, nb))
  (more, b11) = bucket_take(b10, 0, 1)
  all_ok and not more and bucket_wait_ms(b11, 0, 1) == some(200) and bucket_take(b11, 200, 1).0 and bucket_tokens(b11, 1000000) == 10.0 and bucket_wait_ms(b, 0, 11) == none and bucket_wait_ms(b, 0, 10) == some(0) and bucket_take(b11, 0, 0).0

test bucket_clock_skew = do
  (_, b) = bucket_take(bucket(4, 1.0, 1000), 1000, 4)
  bucket_tokens(b, 500) == 0.0 and bucket_take(b, 500, 1) == (false, b) and bucket_tokens(b, 1500) == 0.5 and bucket_wait_ms(b, 1500, 2) == some(1500)

test sliding_window = do
  w = window_limiter(2, 1000)
  (a, w1) = window_take(w, 0)
  (b, w2) = window_take(w1, 10)
  (c, w3) = window_take(w2, 20)
  (d, _) = window_take(w3, 1000)
  a and b and not c and window_remaining(w2, 20) == 0 and window_wait_ms(w3, 20) == 980 and d and window_remaining(w3, 1010) == 2 and window_wait_ms(w, 0) == 0 and window_remaining(w, 0) == 2

test run_hinted_handled = do
  var slept = []
  o = handle run_hinted(constant(10, 4), always_fails, e => e != "fail 3", x => some(42))
  | retry_sleep(ms) => do
    slept := slept.push(ms)
    resume()
  | retry_now() => resume(0)
  o.stop == NotRetryable and o.attempts == 3 and slept == [42, 42]

test huge_waits_saturate = capped(constant(0, 3), -1e300) == 0 and bucket_wait_ms(Bucket{capacity: 1, per_sec: 1e-300, tokens: 0.0, updated_ms: 0}, 0, 1) == some(9223372036854775807)
